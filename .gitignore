# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only working artifacts — deliberately NOT in the repo (2026-08-02).
# All of these still live on disk; they are simply things the running site never
# loads, and they accounted for 19.4 MB of a 29 MB repo.
#
#  · raw/superseded source downloads for the hero background
#  · our own render screenshots (regenerate them; don't commit them)
#  · the target's real video + poster, kept locally as a grading reference only
#
# `assets/measurements.json` IS tracked — it is small and is the CDP evidence
# that features/hero/CONTEXT.md cites.
features/*/assets/*.mp4
features/*/assets/render-*.png
public/video/hero-original.mp4
public/video/hero-poster-original.jpg
